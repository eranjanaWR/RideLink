# RideLink local development environment
# Copy this file to .env.local and fill in your own private values.
# Never commit .env or .env.local.
# .env.local is preferred; legacy .env is also supported.
# FARE_PAYMENT_MONGODB_URI is preferred; PAYMENT_MONGODB_URI is legacy.
# In run-local.sh, quote values containing shell-special characters, for example:
# ACCOUNT_MONGODB_URI='mongodb+srv://...'
# JWT_SECRET='your-local-secret'
# INTERNAL_SERVICE_KEY='a-separate-random-local-service-key'

ACCOUNT_MONGODB_URI=
DRIVER_MONGODB_URI=
RIDE_MONGODB_URI=
FARE_PAYMENT_MONGODB_URI=
JWT_SECRET=
INTERNAL_SERVICE_KEY=

# Optional local port overrides
ACCOUNT_PORT=8081
DRIVER_PORT=8082
RIDE_PORT=8083
PAYMENT_PORT=8084
